# Dockerfile for Finance Agent (Purple Agent)
FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt pyproject.toml ./

# Install Python dependencies with exact versions from venv
# Upgrade pip, setuptools, and wheel first
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY scenarios/ ./scenarios/
COPY data/ ./data/
COPY query_finance_agent.py ./

# Create .env file placeholder (will be overridden by environment variables or volume mount)
RUN touch .env

# Expose port for finance agent
EXPOSE 9099

# Run finance agent
CMD ["python", "scenarios/finance/finance_agent.py", "--host", "0.0.0.0", "--port", "9099"]

